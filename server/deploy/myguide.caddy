# Installed as /etc/caddy/sites/myguide.caddy. No log directive: the server keeps no IP addresses (spec 6.2).
myguide.itsalie.xyz {
	handle /v1/* {
		reverse_proxy 127.0.0.1:8710 {
			flush_interval -1
		}
	}
	handle /health {
		reverse_proxy 127.0.0.1:8710
	}
	handle {
		root * /srv/www/myguide
		file_server
	}
}
