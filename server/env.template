# MyGuide server settings. Copy to /etc/myguide/env and fill in OPENAI_API_KEY.
# Format: KEY=VALUE, one per line, no quotes. Lines starting with # are comments.

# Free calls per device per UTC day, per kind
QUOTA_STORY_PER_DAY=80
QUOTA_SPEECH_PER_DAY=80
QUOTA_IMAGE_PER_DAY=4

# Abuse guards per device
RATE_PER_MINUTE=15
REQUESTS_PER_DEVICE_PER_DAY=200
TOKENS_PER_DEVICE_PER_DAY=1500000
SPEECH_CHARS_PER_DEVICE_PER_DAY=200000

# Spend caps per UTC day, USD
DAILY_SPEND_CAP_USD=5.00
DEVICE_SPEND_CAP_USD=1.00

# Request and upstream limits
MAX_BODY_BYTES=8388608
UPSTREAM_TIMEOUT_SECONDS=120

# Attestation
CHALLENGE_TTL_SECONDS=300
ATTESTS_PER_IP_PER_HOUR=20
ALLOW_DEVELOPMENT_ATTEST=1
APPLE_TEAM_ID=MW432M4HL3
APPLE_BUNDLE_ID=io.github.birgerlie.MyGuide

# Allowed models per kind, comma-separated
MODELS_STORY=gpt-5-mini
MODELS_SPEECH=gpt-4o-mini-tts
MODELS_IMAGE=gpt-image-2.5-flare

# Prices, USD. Install-day best knowledge: CHECK at openai.com/api/pricing before deploy.
# PRICE_<MODEL>=<input per M tokens>,<cached input per M tokens>,<output per M tokens>
# PRICE_SPEECH_<MODEL>=<per M characters>
# <MODEL> is the model name uppercased with - and . replaced by _
PRICE_GPT_5_MINI=0.25,0.025,2.00
PRICE_GPT_IMAGE_2_5_FLARE=5.00,1.25,40.00
PRICE_SPEECH_GPT_4O_MINI_TTS=15.00

# Retention
LOG_RETENTION_DAYS=90

# Credits a call costs once the free quota of its kind is used up
CREDITS_PER_STORY=1
CREDITS_PER_SPEECH=0
CREDITS_PER_IMAGE=2

# Service
LISTEN_PORT=8710

# The OpenAI key. Only ever set in /etc/myguide/env on the server, never in the repo.
OPENAI_API_KEY=
